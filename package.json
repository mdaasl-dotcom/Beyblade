{
  "name": "beyblade-xr-stage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Camera-based AR tracking overlay for a physical Beyblade Stadium: spin/RPM, position, collisions, ring-out, and battle stats, with an optional WebXR anchor view.",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "npx --yes http-server -p 8080 -c-1 .",
    "electron": "electron .",
    "dist:win": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.beyblade.xrstage",
    "productName": "Beyblade XR Stage",
    "files": [
      "index.html",
      "css/**/*",
      "src/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
